{
  "name": "AI AgentBox Codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "AI AgentBox Web App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "cd agentbox-fullstack && npm install",
  "postStartCommand": "cd agentbox-fullstack && npm start"
}
