# ----------------------------------------------------
# 1. WÄHLE DEIN KI-MODELL
# Optionen: "gemini", "openai", "anthropic", "deepseek"
# ----------------------------------------------------
LLM_PROVIDER="gemini"

# ----------------------------------------------------
# 2. TRAGE DEINEN API-KEY EIN
# ----------------------------------------------------
# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# OpenAI (ChatGPT / gpt-4o-mini)
OPENAI_API_KEY=""

# Anthropic (Claude 3.5 Sonnet)
# Hinweis: Die Ausführung (Function Calling) ist für Anthropic in diesem Lab noch nicht angebunden.
# Das Routing/die Evaluation funktioniert jedoch!
# Für die volle Ausführung empfiehlt sich Gemini oder OpenAI.
ANTHROPIC_API_KEY=""

# DeepSeek (deepseek-chat)
DEEPSEEK_API_KEY=""

PORT=3000
